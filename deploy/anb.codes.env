# The box for anb.codes: homes at /codes/anb/<user>, API at https://box.anb.codes/api
# (reached through a Cloudflare Tunnel, so it only listens on localhost).
# Used by deploy/simplebox.service and by `bun --env-file=deploy/anb.codes.env server/cli.ts ...`.
NODE_ENV=production
BOX_DOMAIN=anb.codes
BOX_PUBLIC_URL=https://box.anb.codes
BOX_HOST=127.0.0.1
PORT=7430
BOX_DATA=/home/andrew/storage/simplebox-data
BOX_SIGNUP=off
BOX_DIRECTORY=https://dir.anb.codes
