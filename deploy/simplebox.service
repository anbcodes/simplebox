# The anb.codes box. Install with:
#   sudo cp deploy/simplebox.service /etc/systemd/system/ && sudo systemctl enable --now simplebox
[Unit]
Description=The Shared Computer: box for anb.codes
After=network-online.target
Wants=network-online.target

[Service]
# No WorkingDirectory: every path is absolute, and it would tie the service to the
# storage disk's mount unit.
User=andrew
EnvironmentFile=/home/andrew/storage/code/shared-computer/deploy/anb.codes.env
ExecStart=/home/andrew/.bun/bin/bun /home/andrew/storage/code/shared-computer/server/index.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
