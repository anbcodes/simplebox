# The directory of boxes at https://dir.anb.codes (lists /, /com, ...). Install with:
#   sudo cp deploy/simplebox-directory.service /etc/systemd/system/ && sudo systemctl enable --now simplebox-directory
[Unit]
Description=The Shared Computer: directory of boxes
After=network-online.target
Wants=network-online.target

[Service]
# No WorkingDirectory: every path is absolute, and it would tie the service to the
# storage disk's mount unit.
User=andrew
Environment=DIR_PORT=7431 DIR_HOST=127.0.0.1 DIR_DATA=/home/andrew/storage/simplebox-directory
ExecStart=/home/andrew/.bun/bin/bun /home/andrew/storage/code/shared-computer/directory/index.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
